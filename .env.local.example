# Entorno LOCAL (APP_ENV=local, el default). Copiá este archivo como .env.local.
# Lo marcado como obligatorio frena el arranque si falta; el resto tiene un default.

# --- Modelo -----------------------------------------------------------------------
# AGENT_MODEL es el modelo por defecto (Haiku 5.5 por LiteLLM, si no se define).
# AGENT_MODELS son los que se eligen en el chat ("modelo=Etiqueta", separados por coma, se
# pueden mezclar proveedores); el esfuerzo que ofrece cada uno sale de lo que soporta.
# Vacío = solo AGENT_MODEL. Cada proveedor lee su propia API key: la app no arranca si
# falta la de algún modelo elegido. Si activás el routing por skill, cambiá MODEL_ROUTES.
#
# A) Anthropic con LiteLLM (el default).
ANTHROPIC_API_KEY=
# AGENT_MODEL=anthropic/claude-haiku-5-5
# AGENT_MODELS=anthropic/claude-haiku-5-5=Haiku 5.5,anthropic/claude-sonnet-5-5=Sonnet 5.5,anthropic/claude-opus-5-5=Opus 5.5
# MODEL_ROUTES=dashboard=anthropic/claude-sonnet-5-5   # modelo por skill (routing desactivado en agent.py)
#
# B) Gemini directo con ADK, sin LiteLLM: el nombre va sin proveedor.
#    Clave de Google AI Studio (https://aistudio.google.com/apikey):
# GOOGLE_API_KEY=
#    ...o Vertex AI, que usa las credenciales de Google Cloud del servidor:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# AGENT_MODEL=gemini-3.8-flash
# AGENT_MODELS=gemini-3.8-flash=Gemini 3.8 Flash,anthropic/claude-haiku-5-5=Haiku 5.5,anthropic/claude-sonnet-5-5=Sonnet 5.5,anthropic/claude-opus-5-5=Opus 5.5
#
# C) Gemini con LiteLLM (la misma clave de AI Studio, con otro nombre).
# GEMINI_API_KEY=
# AGENT_MODEL=gemini/gemini-3.8-flash
#
# D) OpenAI con LiteLLM.
# OPENAI_API_KEY=
# AGENT_MODEL=openai/gpt-5
# AGENT_MODELS=openai/gpt-5=GPT-5,openai/gpt-5-mini=GPT-5 mini

# --- Warehouse (BigQuery) ------------------------------------------------------------
# Obligatorio: proyecto donde corren y se facturan las consultas.
WAREHOUSE_PROJECT=
# Datasets habilitados como "proyecto.dataset", separados por coma (vacío = sin restricción).
WAREHOUSE_DATASETS=
# MAX_BYTES_SCANNED=21474836480   # 20 GiB por consulta
# AGENT_MAX_ROWS=50
# BIGQUERY_MCP_URL=https://bigquery.googleapis.com/mcp
# Credenciales del servidor (catálogo y sugerencias). Vacío = las de
# `gcloud auth application-default login`, o la ruta a una clave JSON:
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Login con Google (única forma de entrar) ----------------------------------------------
# Obligatorio: cliente OAuth "Aplicación web" de DESARROLLO, con la URI de vuelta
# http://localhost:8765/auth/callback (ver docs/primeros-pasos.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En local, vacío: la app usa la URL desde la que entrás (http://localhost:8765).
PUBLIC_URL=
# Obligatorio al menos uno: quiénes pueden entrar (separados por coma).
ADMIN_EMAILS=
# ALLOWED_EMAIL_DOMAINS=           # cuentas del Workspace de estos dominios
# ALLOWED_EMAILS=                  # mails sueltos (por ejemplo, de Gmail)
# QUERY_CREDENTIALS=reader         # reader: cada persona consulta con su cuenta; server: la del servidor
# SESSION_DAYS=14
# Vacío en local: se genera una y se guarda en DATA_DIR/secret_key.
# SECRET_KEY=

# --- Datos ------------------------------------------------------------------------------------
# Relativas a la carpeta del proyecto.
# DATA_DIR=data
# KNOWLEDGE_OKF_DIR=knowledge-okf
# CHAT_RETENTION_DAYS=0            # chats sin actividad en más de N días se borran (0 = nunca)
# DEFAULT_TTL_SECONDS=3600         # caché de las consultas en vivo de los dashboards

# --- Conocimiento ----------------------------------------------------------------------------
# KNOWLEDGE_CURATORS=              # además de los admins, quiénes aprueban (mails, coma)
# CATALOG_SYNC_HOURS=24            # resincroniza el catálogo al arrancar si es más viejo (0 = nunca)
# KNOWLEDGE_OKF_AUTO=1             # regenera el bundle OKF al aprobar o deprecar
# KB_INDEX_MAX_LINES=60

# --- Migración de datos de antes del login ---------------------------------------------------
# Id viejo a pasar a un mail con `open-bi migrate <mail>`.
# DEFAULT_USER_ID=
