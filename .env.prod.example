# Entorno PRODUCCIÓN (APP_ENV=prod, lo fija compose.yaml). Copiá este archivo como
# .env.prod en el servidor. Lo marcado como obligatorio frena el arranque si falta.
# Rutas y credencial de Google las fija compose.yaml (volumen /data y secreto).

# --- Modelo -----------------------------------------------------------------------
# AGENT_MODEL es el modelo por defecto (Haiku 5.5 por LiteLLM, si no se define).
# AGENT_MODELS son los que se eligen en el chat ("modelo=Etiqueta", separados por coma, se
# pueden mezclar proveedores); el esfuerzo que ofrece cada uno sale de lo que soporta.
# Vacío = solo AGENT_MODEL. Cada proveedor lee su propia API key: la app no arranca si
# falta la de algún modelo elegido. Si activás el routing por skill, cambiá MODEL_ROUTES.
#
# A) Anthropic con LiteLLM (el default).
ANTHROPIC_API_KEY=
# AGENT_MODEL=anthropic/claude-haiku-5-5
# AGENT_MODELS=anthropic/claude-haiku-5-5=Haiku 5.5,anthropic/claude-sonnet-5-5=Sonnet 5.5,anthropic/claude-opus-5-5=Opus 5.5
# MODEL_ROUTES=dashboard=anthropic/claude-sonnet-5-5
#
# B) Gemini directo con ADK, sin LiteLLM: el nombre va sin proveedor.
#    Clave de Google AI Studio (https://aistudio.google.com/apikey):
# GOOGLE_API_KEY=
#    ...o Vertex AI, que usa las credenciales de Google Cloud del servidor:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# AGENT_MODEL=gemini-3.8-flash
# AGENT_MODELS=gemini-3.8-flash=Gemini 3.8 Flash,anthropic/claude-haiku-5-5=Haiku 5.5,anthropic/claude-sonnet-5-5=Sonnet 5.5,anthropic/claude-opus-5-5=Opus 5.5
#
# C) Gemini con LiteLLM (la misma clave de AI Studio, con otro nombre).
# GEMINI_API_KEY=
# AGENT_MODEL=gemini/gemini-3.8-flash
#
# D) OpenAI con LiteLLM.
# OPENAI_API_KEY=
# AGENT_MODEL=openai/gpt-5
# AGENT_MODELS=openai/gpt-5=GPT-5,openai/gpt-5-mini=GPT-5 mini

# --- Warehouse (BigQuery) ------------------------------------------------------------
# Obligatorio: proyecto donde corren y se facturan las consultas.
WAREHOUSE_PROJECT=
# Datasets habilitados como "proyecto.dataset", separados por coma (vacío = sin restricción).
WAREHOUSE_DATASETS=
# MAX_BYTES_SCANNED=21474836480
# AGENT_MAX_ROWS=50
# BIGQUERY_MCP_URL=https://bigquery.googleapis.com/mcp

# --- Login con Google (única forma de entrar) ----------------------------------------------
# Obligatorio: cliente OAuth "Aplicación web" de PRODUCCIÓN, con la URI de vuelta
# <PUBLIC_URL>/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obligatorio en prod, con https: la URL pública (el hostname del túnel).
PUBLIC_URL=https://bi.tudominio.com
# Obligatorio al menos uno: quiénes pueden entrar (separados por coma).
ADMIN_EMAILS=
# ALLOWED_EMAIL_DOMAINS=
# ALLOWED_EMAILS=
# QUERY_CREDENTIALS=reader
# SESSION_DAYS=14
# Obligatorio en prod (32+ caracteres). Firma las cookies y cifra los tokens de Google:
# si cambia, se cierran todas las sesiones y cada uno vuelve a dar el permiso de BigQuery.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Datos ------------------------------------------------------------------------------------
# CHAT_RETENTION_DAYS=0
# DEFAULT_TTL_SECONDS=3600

# --- Conocimiento ----------------------------------------------------------------------------
# KNOWLEDGE_CURATORS=
# CATALOG_SYNC_HOURS=24
# KNOWLEDGE_OKF_AUTO=1
# KB_INDEX_MAX_LINES=60

# --- Migración de datos de antes del login ---------------------------------------------------
# DEFAULT_USER_ID=
